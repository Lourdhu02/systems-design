# Optional: only needed if you run the calculators/ notebooks against live pricing APIs.
# All notebooks ship with hardcoded baselines and run offline by default.

# AWS pricing API (optional, for gpu-cost.ipynb live mode)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# OpenAI / Anthropic token pricing (optional, for rag-tco.ipynb live mode)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Set to 1 to use baked-in 2026 reference prices instead of live APIs
USE_OFFLINE_PRICES=1
